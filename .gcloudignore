**/*.pyc
README.md
demo/
docs/
dashboard/
scripts/
firebase.json
.firebaserc
hosting/
backend/.venv/
backend/.env
backend/.env.*
backend/var/
backend/tests/
backend/*.egg-info/
backend/*.md
data/raw/
data/*.building*
data/*.wal
backend/.hypothesis/
backend/.pytest_cache/
backend/cache/
