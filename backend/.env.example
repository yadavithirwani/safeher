# SafeHer settings. Copy to backend/.env (gitignored) and fill in. Never commit real values.
# Every value is optional except EARTHDATA_TOKEN, which only the data build needs. Without the optional
# ones the app runs on open data alone. A value that IS set but fails (wrong key, API off, no quota)
# shows an error; it is never silently replaced. Don't wrap values in quotes.

# ---------------------------------------------------------------------------------------------------
# Data build: needed once, for `python -m safeher.data build`
# ---------------------------------------------------------------------------------------------------
# NASA Earthdata token: downloads the Black Marble night-light rasters (~380 MB).
# Get it at https://urs.earthdata.nasa.gov → Generate Token (it expires after 60 days). Then sign in
# once at https://ladsweb.modaps.eosdis.nasa.gov with the same account and accept the data licence.
# The OpenStreetMap, NCRB and Bengaluru police downloads need no account.
EARTHDATA_TOKEN=

# ---------------------------------------------------------------------------------------------------
# Google Maps: basemap, search suggestions, live "open now", Google route comparison, Street View,
# and HerSide's Google Maps grounding
# ---------------------------------------------------------------------------------------------------
# Key from a Cloud project with billing. Enable: Map Tiles API, Places API (New), Routes API,
# Street View Static API (and Geocoding API). Restrict the key to those APIs. Don't add a website
# restriction, because the server calls Maps itself. Check it with `python -m safeher.google_check`.
# Unset: CARTO basemap (OpenStreetMap data) and SafeHer's own search.
GOOGLE_MAPS_API_KEY=

# ---------------------------------------------------------------------------------------------------
# Gemini 2.5 (route explanations, HerSide, HerSide's safety-only check). Pick ONE option.
# Priority when several are set: GOOGLE_CLOUD_PROJECT (ADC) > VERTEX_API_KEY > GEMINI_API_KEY.
# ADC is much faster: ~1.4 s a call vs ~12 s through the key (18 Oct 2026).
# Only Gemini 2.5 Flash / Flash-Lite models are accepted; anything else is refused.
# ---------------------------------------------------------------------------------------------------
# a) Shared Vertex AI API key (billed to the safeher-511808 project). Slower; use it only if you
#    can't use option b. Ask the project owner for it. Share it privately, never in Git or chat.
VERTEX_API_KEY=

# b) Recommended: Vertex AI with Application Default Credentials (your own Google sign-in, no key
#    in this file). The project owner gives your Google account "Vertex AI User" (docs/DEPLOY.md).
#    Run once: gcloud auth application-default login, and enable the Vertex AI API on the project.
# GOOGLE_CLOUD_PROJECT=safeher-511808
# GOOGLE_CLOUD_LOCATION=global             # Vertex region; "global" has the most capacity

# c) AI Studio key (https://aistudio.google.com/apikey). New AI Studio keys can't use Gemini 2.5,
#    so this only works for older keys.
GEMINI_API_KEY=

# Model override for explanations (default in config/app.json: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------------------------------------------
# HerSide chat companion (Google ADK). See backend/CHATBOT_README.md.
# ---------------------------------------------------------------------------------------------------
# gemini (uses option a or b above) or ollama (local, free, no Maps grounding).
# Default: gemini when a or b is set, otherwise ollama.
# CHATBOT_PROVIDER=gemini
# CHATBOT_MODEL=gemini-2.5-flash           # with ollama, e.g. llama3.2:3b (run: ollama pull llama3.2:3b)
# OLLAMA_API_BASE=http://localhost:11434

# ---------------------------------------------------------------------------------------------------
# Route explanations: provider choice. auto | gemini | ollama | template
#   auto = Gemini when configured, otherwise the fact-based template summary
# ---------------------------------------------------------------------------------------------------
# SAFEHER_LLM=auto
# OLLAMA_URL=http://localhost:11434/api/generate
# OLLAMA_MODEL=phi3:mini                   # used only with SAFEHER_LLM=ollama

# ---------------------------------------------------------------------------------------------------
# Server settings. The defaults suit local use; the Cloud Run deploy (scripts/deploy.sh) sets these.
# ---------------------------------------------------------------------------------------------------
# SAFEHER_USERDB=sqlite                    # firestore on Cloud Run (reports + live trips); needs ADC
# SAFEHER_CORRIDOR_CACHE=8                 # route areas kept in memory per process (lower = less RAM)
# SAFEHER_CONFIG_DIR=/path/to/config       # default: the repo's config/; where cities.json / scoring.json / app.json live
