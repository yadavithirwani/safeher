# Copy to backend/.env (gitignored) and fill in. Never commit real values.

# Required for `python -m safeher.data build` (NASA night lights). https://urs.earthdata.nasa.gov → Generate Token
EARTHDATA_TOKEN=

# Optional: Google basemap, search, live open-now, Google route comparison, Street View.
# Enable Map Tiles API, Places API (New), Routes API, Street View Static API on the key's project.
GOOGLE_MAPS_API_KEY=

# Gemini 2.5 on Vertex AI, either way (AI Studio keys can no longer use Gemini 2.5):
#  a) A shared Vertex AI API key (simplest for a team; billed to the Cloud project). Takes priority.
VERTEX_API_KEY=
#  b) Or Application Default Credentials (no key in this file).
# Sign in once: gcloud auth application-default login (or Google's setup_adc.sh). Used for route
# explanations and HerSide; takes priority over GEMINI_API_KEY.
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=global

# Optional: route explanations by Gemini via an AI Studio key instead. https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=

# Optional: HerSide chat companion (Google ADK). ollama (local) or gemini. See backend/CHATBOT_README.md.
# CHATBOT_PROVIDER=ollama
# CHATBOT_MODEL=llama3.2:3b
# OLLAMA_API_BASE=http://localhost:11434

# Optional: explanations by a local Ollama model instead (SAFEHER_LLM=ollama). auto | gemini | ollama | template
# SAFEHER_LLM=auto
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3:latest
